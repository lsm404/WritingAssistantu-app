{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "写作助手",
  "version": "1.0.1",
  "identifier": "com.openclaw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "写作助手",
        "width": 1120,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3Nzk2OTUwNDRFNDk3NjkKUldScGwrUkVVR2w1dDErMHhUK2dndUk5R3pPalRiUXFnNStsN1FteHNjSldTN2loV3VGYklEVzYK",
      "endpoints": [
        "http://49.235.172.63:3100/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer.ico",
        "installMode": "perMachine",
        "installerHooks": "nsis/tauri-hooks.nsh"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
